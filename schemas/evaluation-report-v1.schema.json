{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saptayh-8910/qa-compliance-sentry/schemas/evaluation-report-v1.schema.json",
  "title": "QA Compliance Sentry Evaluation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "summary", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run": {"$ref": "#/$defs/run"},
    "summary": {"$ref": "#/$defs/summary"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "nullableMetric": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "created_at", "dataset", "grader", "provider", "model", "reasoning_effort"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "dataset": {"type": "string", "minLength": 1},
        "grader": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1},
        "reasoning_effort": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "passed_count", "pass_rate", "mean_context_precision", "mean_context_recall", "hit_rate_at_k", "mean_reciprocal_rank", "mean_citation_precision", "mean_citation_recall"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "passed_count": {"type": "integer", "minimum": 0},
        "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_context_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_context_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "hit_rate_at_k": {"$ref": "#/$defs/nullableMetric"},
        "mean_reciprocal_rank": {"$ref": "#/$defs/nullableMetric"},
        "mean_citation_precision": {"$ref": "#/$defs/nullableMetric"},
        "mean_citation_recall": {"$ref": "#/$defs/nullableMetric"}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "source", "heading"],
      "properties": {
        "identifier": {"type": "integer", "minimum": 1},
        "source": {"type": "string", "minLength": 1},
        "heading": {"type": "string", "minLength": 1}
      }
    },
    "answer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["text", "citations"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_precision", "context_recall", "hit_at_k", "reciprocal_rank", "citation_precision", "citation_recall"],
      "properties": {
        "context_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "context_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "hit_at_k": {"type": ["boolean", "null"]},
        "reciprocal_rank": {"$ref": "#/$defs/nullableMetric"},
        "citation_precision": {"$ref": "#/$defs/nullableMetric"},
        "citation_recall": {"$ref": "#/$defs/nullableMetric"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "detail": {"type": "string"}
      }
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "reasoning_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "passed", "failure_summary", "error", "answer", "metrics", "checks", "telemetry"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "failure_summary": {"type": "string"},
        "error": {"type": ["string", "null"]},
        "answer": {"$ref": "#/$defs/answer"},
        "metrics": {"$ref": "#/$defs/metrics"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_seconds", "usage"],
          "properties": {
            "duration_seconds": {"type": "number", "minimum": 0},
            "usage": {"$ref": "#/$defs/usage"}
          }
        }
      }
    }
  }
}
