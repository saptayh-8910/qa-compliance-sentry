{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saptayh-8910/qa-compliance-sentry/schemas/benchmark-report-v1.schema.json",
  "title": "QA Compliance Sentry Repeated Benchmark Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "summary", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_id", "created_at", "dataset", "grader", "provider", "model", "reasoning_effort", "repetitions"],
      "properties": {
        "benchmark_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "dataset": {"type": "string", "minLength": 1},
        "grader": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1},
        "reasoning_effort": {"type": ["string", "null"], "minLength": 1},
        "repetitions": {"type": "integer", "minimum": 2}
      }
    },
    "summary": {"$ref": "#/$defs/summary"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "minimum_seconds", "p50_seconds", "p95_seconds", "maximum_seconds", "mean_seconds"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1},
        "minimum_seconds": {"type": "number", "minimum": 0},
        "p50_seconds": {"type": "number", "minimum": 0},
        "p95_seconds": {"type": "number", "minimum": 0},
        "maximum_seconds": {"type": "number", "minimum": 0},
        "mean_seconds": {"type": "number", "minimum": 0}
      }
    },
    "tokens": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sample_count", "total_input_tokens", "total_output_tokens", "total_tokens", "total_reasoning_tokens", "mean_total_tokens", "p50_total_tokens", "p95_total_tokens"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1},
        "total_input_tokens": {"type": "integer", "minimum": 0},
        "total_output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "total_reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "mean_total_tokens": {"type": "number", "minimum": 0},
        "p50_total_tokens": {"type": "number", "minimum": 0},
        "p95_total_tokens": {"type": "number", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "sample_count", "passed_sample_count", "sample_pass_rate", "stable_case_count", "stability_rate", "response_stable_case_count", "response_stability_rate", "latency", "tokens"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 1},
        "passed_sample_count": {"type": "integer", "minimum": 0},
        "sample_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "stable_case_count": {"type": "integer", "minimum": 0},
        "stability_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "response_stable_case_count": {"type": "integer", "minimum": 0},
        "response_stability_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "latency": {"$ref": "#/$defs/latency"},
        "tokens": {"$ref": "#/$defs/tokens"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "question", "expected_behavior", "sample_count", "passed_count", "pass_rate", "stable", "verdict", "answer_variant_count", "citation_variant_count", "response_stable", "latency", "tokens"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "expected_behavior": {"enum": ["supported", "abstain"]},
        "sample_count": {"type": "integer", "minimum": 2},
        "passed_count": {"type": "integer", "minimum": 0},
        "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "stable": {"type": "boolean"},
        "verdict": {"enum": ["consistently-passed", "consistently-failed", "variable"]},
        "answer_variant_count": {"type": "integer", "minimum": 1},
        "citation_variant_count": {"type": "integer", "minimum": 1},
        "response_stable": {"type": "boolean"},
        "latency": {"$ref": "#/$defs/latency"},
        "tokens": {"$ref": "#/$defs/tokens"}
      }
    }
  }
}
