{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saptayh-8910/qa-compliance-sentry/schemas/evaluation-report-v2.schema.json",
  "title": "QA Compliance Sentry Evaluation Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "summary", "cases"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run": {"$ref": "evaluation-report-v1.schema.json#/$defs/run"},
    "summary": {"$ref": "evaluation-report-v1.schema.json#/$defs/summary"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "question",
        "expected_behavior",
        "passed",
        "failure_summary",
        "error",
        "answer",
        "metrics",
        "checks",
        "telemetry"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "expected_behavior": {"enum": ["supported", "abstain"]},
        "passed": {"type": "boolean"},
        "failure_summary": {"type": "string"},
        "error": {"type": ["string", "null"]},
        "answer": {"$ref": "evaluation-report-v1.schema.json#/$defs/answer"},
        "metrics": {"$ref": "evaluation-report-v1.schema.json#/$defs/metrics"},
        "checks": {
          "type": "array",
          "items": {"$ref": "evaluation-report-v1.schema.json#/$defs/check"}
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_seconds", "usage"],
          "properties": {
            "duration_seconds": {"type": "number", "minimum": 0},
            "usage": {"$ref": "evaluation-report-v1.schema.json#/$defs/usage"}
          }
        }
      }
    }
  }
}
